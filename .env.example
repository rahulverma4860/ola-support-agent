# ── LLM mode ────────────────────────────────────────────────────────
# Set to "mock" for zero-API-key, zero-network-access operation.
# All graded transcripts MUST use MOCK_LLM=mock.
MOCK_LLM=mock

# ── Optional real-LLM keys (only used when MOCK_LLM != mock) ─────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── CrewAI telemetry (MUST be set — no outbound calls allowed) ───────
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true

# ── ChromaDB paths ────────────────────────────────────────────────────
CHROMA_PATH_FIXED=./chroma_fixed
CHROMA_PATH_SENTENCE=./chroma_sentence